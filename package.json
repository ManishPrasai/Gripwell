{
  "name": "nova-tyres",
  "private": true,
  "scripts": {
    "build": "prisma generate --schema=packages/database/prisma/schema.prisma && next build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "msw@2.14.6": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260701.1": true,
    "unrs-resolver@1.12.2": true
  }
}
